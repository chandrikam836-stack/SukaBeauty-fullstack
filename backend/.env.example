# ==== SERVER ====
PORT=5000
NODE_ENV=development
# CLIENT_URL is used to build the password-reset link that gets emailed to
# users, and as the CORS origin. server.js serves the frontend/ folder
# statically from this same backend process, so in local dev this MUST match
# PORT above (http://localhost:5000) — NOT a separate port like 3000, or the
# emailed reset link will point at a URL nothing is running on. If you later
# host the frontend separately (its own dev server or a static host), point
# this at that origin instead.
CLIENT_URL=http://localhost:5000

# ==== DATABASE ====
# Local dev (no setup needed): leave DB_DIALECT=sqlite
# Production (Render/Railway Postgres): set DB_DIALECT=postgres and DATABASE_URL
DB_DIALECT=sqlite
DATABASE_URL=postgres://user:password@host:5432/sukabeauty

# ==== JWT ====
JWT_SECRET=Chandrika
JWT_EXPIRES_IN=7d

# ==== CLOUDINARY (image uploads) ====
CLOUDINARY_CLOUD_NAME=dyjz4yth
CLOUDINARY_API_KEY=646261712778399
CLOUDINARY_API_SECRET=0TEgbsWgi2WeXpfEkgPM6kwtV2o

# ==== RAZORPAY (payments) ====
RAZORPAY_KEY_ID=rzp_test_T9V2pBchRzy4lt
RAZORPAY_KEY_SECRET=a16pGm1d0RKvf9pZOQ6L6eH0

# ==== GMAIL SMTP (OTP / reset emails) ====
# GMAIL_APP_PASSWORD must be a 16-character App Password, NOT your normal
# Gmail password — Google no longer accepts regular passwords for SMTP.
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Paste it below with no spaces.
# Leave both blank to run in dev mode: emails are printed to the server
# console instead of actually sent (no OTP email issue in this mode, since
# there's nothing to deliver — the code is just logged, which is normal for
# local development).
GMAIL_USER=chandrika836@gmail.com
GMAIL_APP_PASSWORD=cfnhdbjzwmssjerg

# Optional overrides — defaults work for Gmail, only change if needed
# (e.g. port 465 is blocked on your network, try 587/false instead).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# DEV-ONLY escape hatch for "self-signed certificate in certificate chain"
# errors caused by local TLS interception (antivirus HTTPS scanning, a
# corporate proxy/VPN, etc). Disables certificate validation for outgoing
# mail — insecure, never usable in production regardless of this value.
# Run `npm run check-smtp` first to diagnose the real cause before reaching
# for this. Defaults to false/off.
# SMTP_ALLOW_INSECURE_TLS=true

# ==== ADMIN SEED (used only by npm run seed) ====
ADMIN_EMAIL=admin@sukabeauty.com
ADMIN_PASSWORD=Admin@12345
SMTP_ALLOW_INSECURE_TLS=true